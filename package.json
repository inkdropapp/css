{
  "name": "@inkdropapp/css",
  "version": "0.10.0",
  "description": "The common stylesheets for Inkdrop",
  "license": "MIT",
  "author": "Takuya Matsuyama <t@inkdrop.app>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inkdropapp/css.git"
  },
  "files": [
    "*.css",
    "*.ts",
    "variables.json"
  ],
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "generate-variable-names": "node ./scripts/generate-variable-names.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepublishOnly": "npm run generate-variable-names"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "postcss": "^8.5.28",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "inkdrop-model": "^3.0.0"
  }
}
